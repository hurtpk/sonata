{
    "name": "sonata-control-room",
    "account_id": "b4858e7c33edcfbfb7c873c96c8142ed",
    "main": "worker.mjs",
    "compatibility_date": "2026-10-28",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": true,
    "assets": {
        "directory": "../public",
        "binding": "ASSETS",
        "run_worker_first": true,
        "html_handling": "none"
    },
    "d1_databases": [{
        "binding": "DB",
        "database_name": "sonata-control-room",
        "database_id": "9d4488d7-00f6-4e72-8641-76149291d428",
        "migrations_dir": "../migrations"
    }],
    "triggers": { "crons": ["0 4 * * *"] },
    "observability": { "enabled": false }
}
